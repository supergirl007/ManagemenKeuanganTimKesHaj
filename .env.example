# ==============================================================================
# KONFIGURASI DATABASE GOOGLE SPREADSHEET (3 VARIABEL UTAMA)
# Salin nilai ini ke file .env lokal atau ke Vercel Settings > Environment Variables
# ==============================================================================

# 1. Spreadsheet_ID: ID dokumen spreadsheet (dari URL: /spreadsheets/d/<ID>/edit)
Spreadsheet_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"

# 2. Google_Services_Account: Email Service Account Google Cloud
# Format: <nama-sa>@<project-id>.iam.gserviceaccount.com
# CATATAN: Pastikan Anda telah klik "Bagikan" (Share) pada Spreadsheet ke email ini sebagai "Editor"
Google_Services_Account="keuangan-haji-sa@project-haji-2026.iam.gserviceaccount.com"

# 3. Google_Private_Key: Kunci privat RSA dari Service Account Google Cloud
# Diawali dengan -----BEGIN PRIVATE KEY----- dan diakhiri -----END PRIVATE KEY-----
Google_Private_Key="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3y...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# OPSIONAL / FALLBACK (Jika menggunakan Google API Key Read-Only)
# ==============================================================================
# GOOGLE_SHEETS_API_KEY="AIzaSy..."
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
